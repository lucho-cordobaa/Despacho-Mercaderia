@model DespachoApp.Models.Cliente
@{
    ViewData["Title"] = "Detalle del cliente";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>@Model.Nombre</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">Datos del cliente</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Nombre</dt><dd class="col-7">@Model.Nombre</dd>
                    <dt class="col-5">DNI / CUIT</dt><dd class="col-7">@Model.DniCuit</dd>
                    <dt class="col-5">Teléfono</dt><dd class="col-7">@(Model.Telefono ?? "-")</dd>
                    <dt class="col-5">Email</dt><dd class="col-7">@(Model.Email ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex justify-content-between">
                <span>Direcciones</span>
                <a asp-controller="Direcciones" asp-action="Create" asp-route-clienteId="@Model.Id" class="btn btn-sm btn-light">+ Agregar</a>
            </div>
            <div class="card-body p-0">
                @if (Model.Direcciones.Any())
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Calle</th><th>Número</th><th>Localidad</th><th>Provincia</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Direcciones)
                            {
                                <tr>
                                    <td>@d.Calle</td>
                                    <td>@d.Numero</td>
                                    <td>@d.Localidad</td>
                                    <td>@d.Provincia</td>
                                    <td>
                                        <a asp-controller="Direcciones" asp-action="Edit" asp-route-id="@d.Id" class="btn btn-xs btn-outline-warning btn-sm">Editar</a>
                                        <form id="formEliminarDireccion_@d.Id"
                                              asp-controller="Direcciones"
                                              asp-action="Delete"
                                              asp-route-id="@d.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalEliminarDireccion_@d.Id">
                                                Eliminar
                                            </button>
                                        </form>

                                        <div class="modal fade" id="modalEliminarDireccion_@d.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">

                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title">Eliminar dirección</h5>

                                                        <button type="button"
                                                                class="btn-close btn-close-white"
                                                                data-bs-dismiss="modal"></button>
                                                    </div>

                                                    <div class="modal-body">
                                                        ¿Está seguro que desea eliminar esta dirección?

                                                        <div class="alert alert-warning mt-3 mb-0">
                                                            Esta acción no se puede deshacer.
                                                        </div>
                                                    </div>

                                                    <div class="modal-footer">

                                                        <button class="btn btn-secondary"
                                                                data-bs-dismiss="modal">
                                                            Cancelar
                                                        </button>

                                                        <button class="btn btn-danger"
                                                                onclick="document.getElementById('formEliminarDireccion_@d.Id').submit();">
                                                            Sí, eliminar
                                                        </button>

                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">No hay direcciones registradas.</p>
                }
            </div>
        </div>
    </div>
</div>
