@model IEnumerable<DespachoApp.Models.Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Usuarios del sistema</h2>
    <a asp-action="Create" class="btn btn-success">+ Nuevo usuario</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>Nombre de usuario</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.NombreUsuario</td>
                    <td><span class="badge @(u.Rol == "Admin" ? "bg-danger" : "bg-secondary")">@u.Rol</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
