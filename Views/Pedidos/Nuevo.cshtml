@{
    ViewData["Title"] = "Nuevo despacho";
}

<h2>Nuevo despacho</h2>
<p class="text-muted">Paso 1: Seleccioná el cliente al que se le despachará la mercadería.</p>

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="SeleccionarCliente" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Cliente</label>
                        <select name="clienteId" asp-items="ViewBag.Clientes" class="form-select" required>
                            <option value="">-- Seleccionar cliente --</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Continuar →</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
